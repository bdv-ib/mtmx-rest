<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="true">

    <property name="LOGS" value="../logs" />
    
    <appender name="Console"
              class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <Pattern>%d %p [%c{1}] - %m%n</Pattern>
        </layout>
    </appender>

    <appender name="RollingFile"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS}/signmx-rest.log</file>
        <encoder
                class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>%d %p %C{1} [%t] %m%n</Pattern>
        </encoder>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- rollover daily and when the file reaches 100 MegaBytes -->
            <fileNamePattern>${LOGS}/archived/signmx-rest-%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy
                    class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
    </appender>

    <appender name="CxfFile"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS}/cxf-logger.log</file>
        <encoder
                class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>%d %p %C{1} [%t] %m%n</Pattern>
        </encoder>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- rollover daily and when the file reaches 100 MegaBytes -->
            <fileNamePattern>${LOGS}/archived/cxf-logger-%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy
                    class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
    </appender>

    <appender name="HttpClientFile"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS}/HttpClient.log</file>
        <encoder
                class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>%d %p %C{1} [%t] %m%n</Pattern>
        </encoder>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- rollover daily and when the file reaches 100 MegaBytes -->
            <fileNamePattern>${LOGS}/archived/HttpClient-%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy
                    class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
    </appender>

    <appender name="ASYNC_RollingFile" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="RollingFile" />
        <discardingThreshold>0</discardingThreshold>
    </appender>

    <appender name="ASYNC_CxfFile" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="CxfFile" />
        <discardingThreshold>0</discardingThreshold>
    </appender>

    <appender name="ASYNC_HttpClientFile" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="HttpClientFile" />
        <discardingThreshold>0</discardingThreshold>
    </appender>

    <!-- LOG "com.baeldung*" at TRACE level -->
    <logger name="org.springframework" level="warn" additivity="true">
        <appender-ref ref="ASYNC_RollingFile" />
    </logger>

    <logger name="com.diximonline" level="debug" additivity="true">
        <appender-ref ref="ASYNC_RollingFile" />
    </logger>

    <logger name="org.apache.cxf" level="debug" additivity="true">
        <appender-ref ref="ASYNC_CxfFile" />
    </logger>

    <logger name="org.apache.http" level="debug" additivity="true">
        <appender-ref ref="ASYNC_HttpClientFile" />
    </logger>

    <!-- LOG everything at INFO level -->
    <root level="info">
        <appender-ref ref="Console" />
    </root>
</configuration>